# Auto detect text files and perform LF normalization
* text=auto

# JS/TS source files should use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# JSON/CSS
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf

# Markdown/YAML
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Config files
.* text eol=lf

# Lock files
package-lock.json text eol=lf

# Windows-specific files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
